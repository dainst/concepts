# the domain we are running at
SERVER_NAME=localhost

# the HTTP port the application will run on. must be free on the host. usually 80
HTTP_PORT=80

# db passwords for application and keyCloack. change them to feel more secure
DATABASE_PASSWORD=postgres
KC_DB_PASSWORD=kc_postgres

# inital keycloak admin
KC_ADMIN_NAME=admin
KC_ADMIN_PASSWORD=istrator

# activate the traffic dashboard? true | false
TRAEFIK_DASHBOARD=false
TRAEFIK_ACCESSLOG=false

# Logelevel - TRACE, DEBUG, INFO, WARN, ERROR or FATAL
LOG_LEVEL=ERROR
