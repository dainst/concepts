{
  "realm": "concepts",
  "enabled": true,

  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "admin",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "manage-users",
              "view-users",
              "query-groups"
            ],
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      }
    ]
  },

  "groups": [
    {
      "name": "admins"
    }
  ],

  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "test@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "clientRoles": {
        "account": [
          "manage-account",
          "view-profile"
        ]
      }
    },
    {
      "username": "concepts-admin",
      "enabled": true,
      "email": "admin@concepts.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-concepts-backend",
      "enabled": true,
      "serviceAccountClientId": "concepts-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ],

  "clients": [
    {
      "clientId": "concepts-frontend",
      "name": "Concepts Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "concepts-backend",
      "name": "Concepts Backend",
      "description": "Technical client for the Concepts NestJS backend",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "development-only-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    }
  ]
}
